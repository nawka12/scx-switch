#!/usr/bin/env bash
# scx-switch — switch the active sched-ext scheduler between three sources
# and keep the choice persistent across reboots.
#
# Sources:
#   pacman  → /usr/bin/<sched>          (from scx-scheds package)
#   repo    → /usr/local/bin/<sched>    (built from sched-ext/scx)
#
# To get the *newer* repo version (i.e. pick up new upstream commits),
# run `scx-switch update`, then `scx-switch repo <sched>`.
#
# Persistence: writes /etc/scx-switch.conf and a systemd unit
# /etc/systemd/system/scx-switch.service that is enabled at boot.
# While active, scx_loader.service is disabled so the two don't fight.
set -euo pipefail

CONF=/etc/scx-switch.conf
UNIT=/etc/systemd/system/scx-switch.service
REPO_DIR="${SCX_REPO_DIR:-$HOME/src/scx}"

need_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "error: this needs root — re-run with sudo" >&2
        exit 1
    fi
}

ensure_unit() {
    [[ -f "$UNIT" ]] && return 0
    cat > "$UNIT" <<'UNIT_EOF'
[Unit]
Description=sched-ext scheduler (managed by scx-switch)
Conflicts=scx_loader.service
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=/etc/scx-switch.conf
ExecStart=/bin/sh -c 'exec "$BINARY" $FLAGS'
KillSignal=SIGINT
Restart=on-failure
RestartSec=2
StartLimitBurst=3
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
UNIT_EOF
    systemctl daemon-reload
}

write_conf() {
    local binary="$1"; shift
    local flags="$*"
    cat > "$CONF" <<EOF
# Generated by scx-switch on $(date -Iseconds)
BINARY=$binary
FLAGS=$flags
EOF
}

cmd_use() {
    need_root
    local source="$1" sched="$2"; shift 2
    local flags="$*"
    local binary
    case "$source" in
        pacman) binary="/usr/bin/$sched" ;;
        repo)   binary="/usr/local/bin/$sched" ;;
        *) echo "error: source must be 'pacman' or 'repo' (got: $source)" >&2; exit 1 ;;
    esac

    if [[ ! -x "$binary" ]]; then
        echo "error: $binary not found or not executable" >&2
        if [[ "$source" == repo ]]; then
            echo "hint: run 'sudo $0 update' to build & install repo binaries first" >&2
        fi
        exit 1
    fi

    ensure_unit
    write_conf "$binary" "$flags"

    # Stop any leftover transient unit from earlier experiments.
    systemctl stop scx-flow.service 2>/dev/null || true

    # Take scx_loader out of the way. Disabling is not enough: the
    # scx-manager GUI DBus-activates scx_loader.service even when disabled,
    # and via Conflicts= that would silently stop this service (kernel
    # falls back to EEVDF). Masking makes that activation fail instead.
    systemctl disable --now scx_loader.service 2>/dev/null || true
    systemctl mask scx_loader.service 2>/dev/null || true

    systemctl enable scx-switch.service >/dev/null
    systemctl restart scx-switch.service
    sleep 0.4
    cmd_status
}

cmd_update() {
    [[ -d "$REPO_DIR/.git" ]] || {
        echo "error: $REPO_DIR is not a git repo (set SCX_REPO_DIR=)" >&2
        exit 1
    }
    echo "==> git pull --ff-only ($REPO_DIR)"
    git -C "$REPO_DIR" pull --ff-only
    echo "==> cargo build --release"
    (cd "$REPO_DIR" && cargo build --release)
    echo "==> sudo install"
    sudo "$REPO_DIR/scx-install.sh"
    # If the active scheduler comes from /usr/local/bin, restart it
    # so it picks up the freshly built binary.
    if [[ -f "$CONF" ]] && grep -q '^BINARY=/usr/local/bin/' "$CONF"; then
        echo "==> restarting active scheduler with new binary"
        sudo systemctl restart scx-switch.service
        sleep 0.4
        cmd_status
    fi
}

cmd_status() {
    echo "── config ──"
    if [[ -f "$CONF" ]]; then
        sed 's/^/  /' "$CONF"
    else
        echo "  (not configured — run: sudo scx-switch pacman|repo <sched>)"
    fi
    echo
    echo "── service ──"
    _se() { systemctl is-enabled "$1" 2>/dev/null | head -1 || true; }
    _sa() { systemctl is-active  "$1" 2>/dev/null | head -1 || true; }
    printf "  scx-switch.service: enabled=%s active=%s\n" \
        "$(_se scx-switch.service)" "$(_sa scx-switch.service)"
    printf "  scx_loader.service: enabled=%s active=%s\n" \
        "$(_se scx_loader.service)" "$(_sa scx_loader.service)"
    # Installs from older versions only disabled scx_loader; warn, because
    # the GUI can DBus-activate it and silently stop the scheduler.
    if [[ "$(_se scx-switch.service)" == "enabled" ]]; then
        case "$(_se scx_loader.service)" in
            enabled|disabled)
                echo
                echo "  WARNING: scx_loader.service is not masked. Opening the scx-manager"
                echo "  GUI can DBus-activate it and silently stop your scheduler."
                echo "  fix: sudo systemctl mask scx_loader.service"
                ;;
        esac
    fi
    echo
    echo "── kernel sched_ext ──"
    printf "  state:    %s\n" "$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo unknown)"
    printf "  attached: %s\n" "$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo '(none)')"
}

cmd_off() {
    need_root
    systemctl disable --now scx-switch.service 2>/dev/null || true
    rm -f "$CONF"
    # Hand control back to scx_loader (DBus-activated; only acts when called).
    systemctl unmask scx_loader.service 2>/dev/null || true
    systemctl enable --now scx_loader.service 2>/dev/null || true
    cmd_status
}

cmd_revert() {
    need_root
    # Step 1: stop our service.
    systemctl disable --now scx-switch.service 2>/dev/null || true
    rm -f "$CONF" "$UNIT"
    systemctl daemon-reload
    # Step 2: remove /usr/local/bin shadow install via scx-revert.sh.
    if [[ -x "$REPO_DIR/scx-revert.sh" ]]; then
        "$REPO_DIR/scx-revert.sh"
    fi
    # Step 3: re-enable scx_loader.
    systemctl unmask scx_loader.service 2>/dev/null || true
    systemctl enable --now scx_loader.service 2>/dev/null || true
    cmd_status
}

usage() {
    cat <<'EOF'
Usage: scx-switch <command> [args]

Switch the active sched-ext scheduler and persist the choice across reboots.

Commands:
  pacman <sched> [flags...]   Use pacman binary from /usr/bin/<sched>
  repo   <sched> [flags...]   Use built binary from /usr/local/bin/<sched>
  update                      git pull + rebuild + reinstall the repo binaries.
                              If a repo-sourced scheduler is active, restart it
                              so it picks up the new build.
  status                      Show config, service state, kernel attach state
  off                         Stop scheduler, fall back to CFS/EEVDF,
                              re-enable scx_loader (keeps unit installed)
  revert                      Full teardown: remove unit, /usr/local/bin/scx_*,
                              re-enable scx_loader. Returns system to pacman-only.

Environment:
  SCX_REPO_DIR   path to the scx source clone (default: $HOME/src/scx)

Examples:
  sudo scx-switch repo scx_flow
  sudo scx-switch repo scx_flow --debug
  sudo scx-switch pacman scx_rusty
  scx-switch update            # pulls + rebuilds, then re-applies if needed
  scx-switch status
  sudo scx-switch off
EOF
}

case "${1:-}" in
    pacman|repo)
        src="$1"; shift
        [[ $# -ge 1 ]] || { echo "error: missing scheduler name" >&2; usage; exit 1; }
        cmd_use "$src" "$@"
        ;;
    update)            cmd_update ;;
    status)            cmd_status ;;
    off)               cmd_off ;;
    revert)            cmd_revert ;;
    -h|--help|help|"") usage ;;
    *) echo "error: unknown command '$1'" >&2; usage; exit 1 ;;
esac
